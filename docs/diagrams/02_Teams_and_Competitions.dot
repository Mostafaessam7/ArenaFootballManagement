digraph Arena { graph [rankdir=TB, bgcolor="white", pad="0.18", nodesep="0.30", ranksep="0.45", splines=polyline, label="Teams players and tournament registration", labelloc=t, fontsize=18, fontname="Arial"]; node [shape=plain, fontname="Arial", fontsize=13]; edge [color="#64748b", fontname="Arial", fontsize=10, arrowsize=0.8, dir=both, arrowtail=tee, arrowhead=odotcrow];
PlayerMemberships [label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0"><TR><TD BGCOLOR="#e8eef4" CELLPADDING="9"><B>PlayerMemberships</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">PK Id</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">FK PlayerId</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">FK TeamId</TD></TR></TABLE>>];
Players [label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0"><TR><TD BGCOLOR="#e8eef4" CELLPADDING="9"><B>Players</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">PK Id</TD></TR></TABLE>>];
Teams [label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0"><TR><TD BGCOLOR="#e8eef4" CELLPADDING="9"><B>Teams</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">PK Id</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">FK ManagerId ?</TD></TR></TABLE>>];
TournamentRosters [label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0"><TR><TD BGCOLOR="#e8eef4" CELLPADDING="9"><B>TournamentRosters</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">PK Id</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">FK TournamentId</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">FK TeamId</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">FK PlayerId</TD></TR></TABLE>>];
Tournaments [label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0"><TR><TD BGCOLOR="#e8eef4" CELLPADDING="9"><B>Tournaments</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">PK Id</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">FK OrganizerId</TD></TR></TABLE>>];
TournamentTeams [label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0"><TR><TD BGCOLOR="#e8eef4" CELLPADDING="9"><B>TournamentTeams</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">PK Id</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">FK TournamentId</TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">FK TeamId</TD></TR></TABLE>>];
Users [label=<<TABLE BORDER="1" COLOR="#94a3b8" CELLBORDER="0" CELLSPACING="0"><TR><TD BGCOLOR="#e8eef4" CELLPADDING="9"><B>Users</B></TD></TR><TR><TD ALIGN="LEFT" CELLPADDING="4">PK Id</TD></TR></TABLE>>];
Players -> PlayerMemberships [arrowtail=teetee, label=""];
Teams -> PlayerMemberships [arrowtail=teetee, label=""];
Users -> Teams [arrowtail=teeodot, label="manager"];
Players -> TournamentRosters [arrowtail=teetee, label=""];
TournamentTeams -> TournamentRosters [arrowtail=teetee, label=""];
Users -> Tournaments [arrowtail=teetee, label="organizer"];
Teams -> TournamentTeams [arrowtail=teetee, label=""];
Tournaments -> TournamentTeams [arrowtail=teetee, label=""];
}