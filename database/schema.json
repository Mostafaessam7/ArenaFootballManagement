      {
        "Name": "CK_Event_Specialization",
        "Sql": "([EventType] = \u0027Match\u0027 AND [TournamentId] IS NOT NULL AND [HomeTeamId] IS NOT NULL AND [AwayTeamId] IS NOT NULL AND [RoundNumber] IS NOT NULL AND [Leg] IS NOT NULL AND [Description] IS NULL) OR ([EventType] = \u0027Community\u0027 AND [Description] IS NOT NULL AND [TournamentId] IS NULL AND [HomeTeamId] IS NULL AND [AwayTeamId] IS NULL AND [RoundNumber] IS NULL AND [Leg] IS NULL AND [HomeScore] IS NULL AND [AwayScore] IS NULL)"
      },
      {
        "Name": "CK_Event_Status",
        "Sql": "[Status] IN (\u0027Scheduled\u0027,\u0027Finished\u0027,\u0027Cancelled\u0027)"
      },
      {
        "Name": "CK_Match_Round",
        "Sql": "[RoundNumber] IS NULL OR ([RoundNumber] \u003E 0 AND [Leg] BETWEEN 1 AND 2)"
      },
      {
        "Name": "CK_Match_Scores",
        "Sql": "[EventType] \u003C\u003E \u0027Match\u0027 OR (([Status] = \u0027Finished\u0027 AND [HomeScore] IS NOT NULL AND [AwayScore] IS NOT NULL AND [HomeScore] BETWEEN 0 AND 99 AND [AwayScore] BETWEEN 0 AND 99) OR ([Status] \u003C\u003E \u0027Finished\u0027 AND [HomeScore] IS NULL AND [AwayScore] IS NULL))"
      },
      {
        "Name": "CK_Match_Teams",
        "Sql": "[HomeTeamId] IS NULL OR [HomeTeamId] \u003C\u003E [AwayTeamId]"
      }
    ]
